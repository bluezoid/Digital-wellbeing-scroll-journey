<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Usage Access is "special access": declaring it here does NOT grant it.
        The user must switch it on manually in Settings > Usage access.
        tools:ignore silences the lint warning that normal apps can't be granted this at install time.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Android 11+ hides other installed apps by default ("package visibility").
        This declares the one kind of app we need to see: anything with a launcher icon.
        It's the narrow alternative to QUERY_ALL_PACKAGES, which Google Play restricts.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ScrollJourneyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScrollJourney">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScrollJourney">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
