<?xml version="1.0" encoding="utf-8"?>
<!-- Static picture shown in the widget picker (Android 12+). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">
    <View
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/widget_preview_dot" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45m"
            android:textColor="#4ADE80"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="of 2h 00m"
            android:textColor="#B4B8D6"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
