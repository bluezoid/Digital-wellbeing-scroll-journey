    <string name="settings_section_credits">About &amp; credits</string>
    <string name="settings_credits_textures">Planet, Sun, ring and star textures: Solar System Scope (solarsystemscope.com), licensed CC BY 4.0. Resized for the app; Ceres and Pluto use stylised stand-in textures.</string>
    <string name="settings_credits_rocket">Rocket model: Kenney “Space Kit” (kenney.nl), CC0 public domain.</string>
    <string name="settings_credits_libraries">Built with Android Jetpack (Compose, Room, WorkManager, Navigation, Lifecycle, Glance) and Kotlin with kotlinx coroutines and serialization, Apache License 2.0.</string>
    <string name="settings_credits_engine">3D rendering: SceneView and Google Filament, Apache License 2.0.</string>
