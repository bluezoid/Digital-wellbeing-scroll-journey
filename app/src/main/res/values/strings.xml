    <string name="settings_background_hint">Scroll Journey saves each day in the background around 00:30. Some phones (realme, Xiaomi, Oppo…) pause background apps; if a day ever goes missing, open this and allow background activity. Opening the app always catches up too.</string>
    <string name="settings_section_journey">Rocket journey</string>
    <string name="settings_journey_since">Journey since %1$s</string>
    <string name="settings_reset_journey">Reset journey</string>
    <string name="settings_reset_subtitle">Rocket back to Earth with 0 fuel. Your usage history is kept.</string>
    <string name="settings_reset_confirm_title">Reset your journey?</string>
    <string name="settings_reset_confirm_body">Your rocket goes back to Earth with 0 fuel and the journey restarts today. Your daily history, colours and minutes are not deleted. This can\'t be undone.</string>
    <string name="settings_reset_confirm_action">Reset</string>
    <string name="settings_reset_done">Journey reset. The rocket is back on Earth.</string>
    <string name="settings_section_privacy">Privacy</string>
    <string name="settings_privacy_body">Everything stays on this phone. Scroll Journey only reads how many minutes the apps you choose were open, using Android\'s Usage Access. It never sees what you do inside them, has no account, no server, no ads and no location. Uninstalling the app deletes all of its data.</string>
