    <string name="settings_backup_hint">Keep a backup before changing phones or reinstalling: uninstalling the app deletes its data.</string>
    <string name="settings_section_help">Help &amp; feedback</string>
    <string name="settings_share_diagnostics">Share diagnostics</string>
    <string name="settings_share_diagnostics_subtitle">Send app status and any crash details to the developer. No app names or per-app usage.</string>
    <string name="settings_section_privacy">Privacy</string>
    <string name="settings_privacy_body">Everything stays on this phone. Scroll Journey only reads how many minutes the apps you choose were open, using Android\'s Usage Access. It never sees what you do inside them, has no account, no server, no ads and no location. Uninstalling the app deletes all of its data, so export a backup first if you want to keep it.</string>
