// Self-lit textured surface: the Sun and the starfield sphere.
// Unlit = not affected by lights or camera exposure: output = texture × `intensity`
// (≈1.0 = texture as-is; >1 brightens, e.g. the Sun).
// Culling none: the starfield sphere is seen from the inside.
material {
    name : space_unlit_textured,
    shadingModel : unlit,
    culling : none,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : baseTexture },
        { type : float, name : intensity }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c = texture(materialParams_baseTexture, getUV0());
        material.baseColor = vec4(c.rgb * materialParams.intensity, 1.0);
    }
}
